# Корзина проекта: мусор не удаляется, а переносится сюда
/.to-delete/

# Производные ассеты и исходные записи (собираются из ROM-дампа и захватов MAME)
/Assets/Converted/
/Assets/Original/
/Audio/VGM music/
# Треки альбома саундтрека (коммерческая музыка) не публикуются; записи эффектов из MAME — публикуются
/Audio/Original/*.mp3
/Audio/Original/*.flac

# Опорные хеши сверок и опорные версии — локальные
/Baselines/
/pre-releases/

# Сборка — кроме готовых файлов для SD-карты
/Build/*
!/Build/_SD/

# ROM-дамп автомата (© Irem) не публикуется: для сборки из исходников нужен свой дамп набора World
/Arcade/

# Архивы для раздачи с эмулятором (vdac2p_package.py) не публикуются
/R-Type VDAC2*.zip

# Кэши Python
__pycache__/
*.pyc
